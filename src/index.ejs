<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <% if (!process.env.IS_ELECTRON) { %>
    <meta name="referrer" content="no-referrer" />
    <style>
      .aegis-boot {
        align-items: center;
        background: #0c111b;
        color: #aab1c0;
        display: flex;
        flex-direction: column;
        font-family: system-ui, sans-serif;
        gap: 12px;
        inset: 0;
        justify-content: center;
        position: fixed;
      }

      .aegis-boot-mark {
        border: 3px solid #293244;
        border-radius: 50%;
        border-top-color: #ffc107;
        height: 26px;
        width: 26px;
        animation: aegis-spin 0.8s linear infinite;
      }

      .aegis-boot strong {
        color: #f2f4f8;
        font-size: 14px;
      }

      .aegis-boot span {
        font-size: 11px;
      }

      @keyframes aegis-spin {
        to { transform: rotate(360deg); }
      }
    </style>
    <% } %>
    <title></title>
  </head>

  <body>
    <div id="app">
      <% if (!process.env.IS_ELECTRON) { %>
      <div class="aegis-boot" role="status">
        <div class="aegis-boot-mark"></div>
        <strong>AegisTube</strong>
        <span>Opening your local library…</span>
      </div>
      <% } %>
    </div>
    <% if (process.env.IS_ELECTRON) { %>
    <iframe
      id="sigFrame"
      src="<%= sigFrameSrc %>"
      csp="default-src 'none'; script-src '<%= sigFrameCspHash %>' 'unsafe-eval'"
      sandbox="allow-scripts"
      height="1"
      width="1"
      style="display: none; pointer-events: none"
      tabindex="-1"
    ></iframe>
    <% } %>
    <!-- webpack builds are automatically injected -->
  </body>

</html>
